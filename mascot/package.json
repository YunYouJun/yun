{
  "name": "@yunyoujun/mascot",
  "version": "0.1.0",
  "description": "Framework-agnostic, pointer-aware mascot eyes with a ready-to-use Xiaoyun cloud rig",
  "type": "module",
  "license": "CC-BY-NC-SA-4.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vue": {
      "types": "./dist/vue.d.mts",
      "import": "./dist/vue.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vite",
    "demo": "vite",
    "demo:build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "happy-dom": "^21.0.4",
    "tsdown": "^0.23.5",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "^5.1.0",
    "vue": "3.5.44",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunYouJun/yun.git",
    "directory": "mascot"
  },
  "homepage": "https://github.com/YunYouJun/yun/tree/main/mascot",
  "bugs": {
    "url": "https://github.com/YunYouJun/yun/issues"
  },
  "keywords": [
    "mascot",
    "xiaoyun",
    "svg",
    "animation",
    "vue"
  ]
}
